<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   pom.xml : Maven のプロジェクト定義ファイル
  ============================================================================
   Java では「どのライブラリを使うか」を自分で 1 個ずつ DL するのではなく、
   このファイルに書いておくと Maven が自動でダウンロードしてくれます。
   （PHP の composer.json、Node の package.json にあたるもの）

   <parent> に spring-boot-starter-parent を指定すると、
   Spring Boot が「相性の良いライブラリのバージョンの組み合わせ」を
   まとめて面倒みてくれるので、<version> を書かない依存が多くなります。
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>jp.komeko</groupId>
  <artifactId>komeko-order</artifactId>
  <version>0.1.0</version>
  <name>komeko-order</name>
  <description>米粉と鉄板 モバイルオーダー（QR注文）システム</description>

  <properties>
    <!-- Java 21 (LTS) でビルドする -->
    <java.version>21</java.version>
    <zxing.version>3.5.4</zxing.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        テストで起動する PostgreSQL のバージョンを本番に合わせる。

        これを書かないと 14 系が使われます。動きはしますが、
        「PostgreSQL で確認した」と言うなら本番と同じ系で確認しないと
        意味が薄れます。本番を上げるときは、ここも一緒に上げること。
      -->
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>16.2.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!-- ▼ Web（Spring MVC / 組み込み Tomcat）。これだけで Web サーバが同梱される -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- ▼ Thymeleaf : HTML テンプレートエンジン（PHP の中に <?= ?> を書く感覚に近い） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- ▼ JPA / Hibernate : Java のクラスと DB のテーブルを対応づける（ORM） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- ▼ Bean Validation : @NotBlank などの入力チェック -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ▼ Spring Security : 厨房 / 管理画面のログイン・権限制御・CSRF 対策 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- ▼ Thymeleaf からログイン中ユーザや権限を参照するための拡張 -->
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <!-- ▼ ZXing : QR コード生成。core だけ使い、PNG 化は自前で行う（依存を増やさないため） -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>${zxing.version}</version>
    </dependency>

    <!-- ▼ Flyway : スキーマ変更の管理（マイグレーション）
         本番は ddl-auto: validate なので、テーブルは自動では作られない。
         「どの SQL をどの順で流したか」を DB 自身に記録させ、
         同じ変更が二度流れないようにするのがマイグレーションツールの役割。
         dev では従来どおり Hibernate の ddl-auto: update に任せる（application-dev.yml で無効化）。 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- PostgreSQL 用の方言。Flyway 10 以降は DB ごとに別 jar が要る -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- ▼ H2 : ファイル 1 つで動く組み込み DB。開発・小規模運用はこれで十分 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ▼ PostgreSQL : 本番でクラウドに載せるとき用（prod プロファイルで使用） -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ▼ DevTools : ソースを保存すると自動再起動（開発中だけ有効） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <!-- ▼ テスト用（JUnit5 / AssertJ / MockMvc） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      ▼ 本物の PostgreSQL をテストの中で起動するためのもの

      本番は PostgreSQL ＋ ddl-auto: validate です。つまり
      マイグレーション SQL が PostgreSQL で 1 文字でも通らなければ、
      本番アプリは起動しません。しかも手元は H2 なので、
      デプロイするまで気づけません。

      Docker は不要で、テストのたびに PostgreSQL の実体を落としてきて
      サブプロセスとして起動します（scope=test なので本番の jar には入りません）。
      Testcontainers を使わないのは Docker を前提にしたくないためです。
    -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>2.0.7</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <!-- mvn spring-boot:run / mvn package で実行可能 jar を作るためのプラグイン -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- ソースを UTF-8 として扱う（日本語コメントが文字化けしないように） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <encoding>UTF-8</encoding>
          <compilerArgs>
            <!-- メソッド引数名を保持する。Spring がフォームの項目名を解決するのに使う -->
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
