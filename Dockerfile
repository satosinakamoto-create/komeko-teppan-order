# =============================================================================
#  ポートフォリオの公開デモ用のコンテナ
# =============================================================================
#  Render / Fly.io / Railway など、Docker が使えるところならどこでも動きます。
#
#  必要な環境変数（ホスティング側の画面で設定する）:
#      SPRING_PROFILES_ACTIVE = demo
#      APP_BASE_URL           = https://＜公開URL＞   ← QRに焼き込まれる。最重要
#
#  ---------------------------------------------------------------------------
#  2 段階に分けている理由（マルチステージビルド）
#  ---------------------------------------------------------------------------
#  1 段目でビルドし、2 段目には「出来上がった jar」だけを持っていきます。
#  Maven も、ソースコードも、ビルドの途中生成物も最終イメージには入りません。
#
#  ・イメージが小さくなる（起動が速い ＝ 無料枠のコールドスタートが短い）
#  ・公開するコンテナの中にソースを置かずに済む
# =============================================================================

# --- 1段目：ビルドする -------------------------------------------------------
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build

# 先に pom.xml だけコピーして依存をダウンロードする。
# ソースを変えただけのときに、この層がキャッシュから再利用されてビルドが速くなる。
COPY pom.xml .
RUN mvn -B dependency:go-offline

COPY src ./src
# テストはここでは流さない。CI（GitHub Actions）で流す前提。
# デプロイのたびに数分待たされると、直したいときに直せなくなる。
RUN mvn -B -DskipTests package

# --- 2段目：動かす -----------------------------------------------------------
FROM eclipse-temurin:21-jre
WORKDIR /app

# root のまま動かさない。もし中に入られても、できることを減らしておく。
RUN useradd --create-home --shell /usr/sbin/nologin komeko
USER komeko

COPY --from=build /build/target/*.jar app.jar

# H2 のファイルと商品画像の置き場所。
# 無料ホスティングでは再起動で消えますが、デモではむしろ好都合
# （荒らされても次の起動できれいに戻る）。
RUN mkdir -p /app/data

EXPOSE 8080

# ---------------------------------------------------------------------------
# メモリの指定。
# 無料枠は 512MB のことが多く、指定しないと JVM がヒープを取りすぎて
# コンテナごと停止させられます（OOM Killed）。
# MaxRAMPercentage は「コンテナに割り当てられた量の何％まで使うか」。
# ---------------------------------------------------------------------------
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -Xss512k"

# ホスティング側が PORT を指定してくることがあるので、それに合わせる。
# 指定が無ければ 8080。
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -Dserver.port=${PORT:-8080} -jar app.jar"]
