# ============================================================================
#  Git 管理から除外するもの
# ----------------------------------------------------------------------------
#  Git は一度コミットしたものが履歴に残り続けます。
#  「秘密の値」「巨大なファイル」「自動生成物」は最初から入れないのが鉄則です。
# ============================================================================

# Maven のビルド成果物
target/
.mvn/wrapper/maven-wrapper.jar

# tools\run.ps1 が自動ダウンロードする Maven 本体
.tools/

# アプリのデータ（H2 の DB ファイル・アップロード画像・注文履歴）
# ★ 実際の注文データと商品画像が入るため、絶対にコミットしない
data/

# 自動バックアップの出力先（中身は data/ と同じ＝注文データそのもの）
backups/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
Thumbs.db
.DS_Store

# ローカル環境変数
.env
